# Copy this file to .env and fill in your real values. Never commit .env.

# Get these from https://dashboard.paymongo.com/developers -> API Keys
# Use the sk_test_ / pk_test_ keys first, switch to sk_live_ / pk_live_ when you're ready to accept real money.
PAYMONGO_SECRET_KEY=REPLACE_WITH_YOUR_PAYMONGO_SECRET_KEY
PAYMONGO_PUBLIC_KEY=REPLACE_WITH_YOUR_PAYMONGO_PUBLIC_KEY

# Get this from PayMongo dashboard -> Developers -> Webhooks, after you register the webhook URL below
PAYMONGO_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SIGNING_SECRET

# The public base URL of this app. On Render this is your service URL, e.g. https://your-app.onrender.com
# Locally this is fine as-is; PayMongo checkout will still work for live redirect testing if you deploy.
BASE_URL=http://localhost:8000

# Random long string used to sign session cookies. Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=REPLACE_WITH_A_RANDOM_64_CHAR_HEX_STRING

# First admin account, auto-created on first run if it doesn't exist
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_REAL_PASSWORD
ADMIN_NAME=Hero Tolosa

# SQLite file path (relative to project root)
DATABASE_URL=sqlite:///./learning_center.db
